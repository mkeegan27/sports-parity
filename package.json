{
  "name": "sports-parity",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @sports-parity/web dev",
    "build": "pnpm -r build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "secrets:check": "secretlint \"**/*\"",
    "prepare": "simple-git-hooks",
    "data:nfl": "tsx scripts/fetch-nfl.ts",
    "data:pll": "tsx scripts/fetch-pll.ts",
    "data": "pnpm data:nfl --from 1999 && pnpm data:pll"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec secretlint $(git diff --cached --name-only --diff-filter=ACM) && pnpm exec prettier --check --ignore-unknown $(git diff --cached --name-only --diff-filter=ACM)"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.1.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "secretlint": "^13.1.0",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "wrangler": "~4.158.0"
  }
}
