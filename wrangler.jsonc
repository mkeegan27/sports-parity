// Cloudflare Workers deploy: the built web app served as static assets.
// The name must match the Worker created in the dashboard.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sports-parity",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "apps/web/dist",
    // Client-side routes like /nfl/2025/8 load index.html.
    "not_found_handling": "single-page-application",
  },
}
